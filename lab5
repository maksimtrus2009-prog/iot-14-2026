from enum import Enum


class Type(Enum):
    SHIRT = 1
    JEANS = 2
    JACKET = 3
    SWEATER = 4
    SHOES = 5
    HAT = 6


class Clothing:
    def __init__(self, name, description, location, colour, size, type_):
        self.name = name
        self.description = description
        self.location = location
        self.colour = colour
        self.size = size
        self.type = type_

    # Додатковий метод класу одягу
    def info(self):
        return (f"{self.name} | {self.type.name} | {self.description} | "
                f"{self.location} | {self.colour} | розмір {self.size}")


class Wardrobe:
    def __init__(self):
        self.items = []

    def add(self, clothing):
        self.items.append(clothing)

    # Сортування одягу за розміром
    def sort_by_size(self):
        self.items.sort(key=lambda c: c.size)

    def show(self):
        for c in self.items:
            print(c.info())


def are_go_out(clothes):
    types = {c.type for c in clothes}
    print(f"Кількість типів одягу: {len(types)}")
    if len(types) > 3:
        print("Так, можна виходити на вулицю")
        return True
    print("Ні, не можна виходити на вулицю")
    return False


if __name__ == "__main__":
    w = Wardrobe()
    w.add(Clothing("Футболка", "Бавовняна", "Шафа", "білий", 48, Type.SHIRT))
    w.add(Clothing("Джинси", "Прямі", "Полиця", "синій", 44, Type.JEANS))
    w.add(Clothing("Куртка", "Зимова", "Вішак", "чорний", 50, Type.JACKET))
    w.add(Clothing("Кросівки", "Спортивні", "Взуттєва шафа", "сірий", 42, Type.SHOES))

    w.sort_by_size()
    w.show()

    are_go_out(w.items)